# Isi dengan kredensial dari project Supabase "dtsen-usulan-solok"
# Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://nlwkpakyfprugqwklxiu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_hBBWf3qjJ1h0B8k7dS8UqA_SH88kyRB

# Untuk fungsi Edge (submit-usulan, jorong-info) yang sudah di-deploy:
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://nlwkpakyfprugqwklxiu.supabase.co/functions/v1

# Server-side saja (JANGAN pakai prefix NEXT_PUBLIC_) -- dari Anomali Cepat,
# dipakai lagi utk fitur Penyisiran Usaha:
SUPABASE_SERVICE_ROLE_KEY=<service_role key dari Supabase Dashboard > Project Settings > API>

# PIN akses tab "Penyisiran Usaha" di /penyisiran (bebas angka/huruf,
# TIDAK pernah dikirim ke browser -- lihat lib/penyisiranAuth.ts). Tambahkan
# juga di Railway > Settings > Variables sebelum deploy.
PENYISIRAN_PIN=

# BARU -- PIN akses tab "Identifikasi PPL" di /penyisiran, SENGAJA BEDA
# dari PENYISIRAN_PIN di atas -- PIN ini yang dibagikan ke PPL/mantan
# pendata SE2026, jadi tidak boleh sama dgn PIN internal BPS (kalau bocor,
# PIN ini cuma bisa mengisi Ada/Tidak Ada/Ragu, tidak bisa buka data
# lengkap/GPS/bukti). Tambahkan juga di Railway > Settings > Variables.
PENYISIRAN_IDENTIFIKASI_PIN=
